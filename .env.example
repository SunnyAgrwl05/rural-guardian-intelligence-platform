APP_NAME=Rural Guardian Intelligence Platform
ENV=development
DEV_SEED=true
SECRET_KEY=change-this-long-random-secret
DATABASE_URL=postgresql+psycopg://app:app@db:5432/assistant
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
MAX_MESSAGE_CHARS=6000

# demo | openrouter | foundry | azure_openai
MODEL_PROVIDER=demo

# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=

# Azure OpenAI v1 fallback
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=


# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Rural Guardian Intelligence Platform
